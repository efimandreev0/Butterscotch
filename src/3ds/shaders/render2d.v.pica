; Butterscotch 2D вершинный шейдер для Citro3D
;
; Атрибуты вершин:
;   v0 = position  (x, y, z, _)
;   v1 = texcoord  (u, v, _, _)
;   v2 = color     (r, g, b, a)
;
; Юниформы:
;   projection[4]  -- ортогональная матрица проекции (row-major через dp4)
;
; Выход:
;   position, texcoord0, color

.fvec projection[4]

.constf myconst(0.0, 1.0, 0.0, 0.0)
.alias  zeros myconst.xxxx
.alias  ones  myconst.yyyy

.out outpos position
.out outtc0 texcoord0
.out outclr color

.alias inpos v0
.alias intex v1
.alias incol v2

.proc main
    ; r0 = inpos с принудительным w = 1.0
    mov r0.xyz, inpos
    mov r0.w,   ones

    ; outpos = projection * r0
    dp4 outpos.x, projection[0], r0
    dp4 outpos.y, projection[1], r0
    dp4 outpos.z, projection[2], r0
    dp4 outpos.w, projection[3], r0

    ; passthrough texcoord (u,v) -- остальные каналы обнуляем
    mov outtc0.xy, intex
    mov outtc0.zw, myconst.xx

    ; passthrough vertex color
    mov outclr, incol

    end
.end
